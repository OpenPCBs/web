# Required only for hosted paid lab verification. Keep secret values in the
# deployment secret store; never expose them through NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Bootstrap administrators on first sign-in. Separate multiple addresses with
# commas. Roles are persisted in D1 and can then be managed in Admin.
ADMIN_EMAILS=owner@example.com

# Required before saving Stripe credentials in Admin. Use a long, random value
# and keep it stable so encrypted settings remain readable across deployments.
ADMIN_SETTINGS_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# Environment fallback for the public Stripe redirect/webhook origin. A valid
# origin saved in Admin > Settings takes precedence. HTTPS is required outside
# local development.
APP_ORIGIN=https://example.com

# Optional public canonical origin used for metadata and sharing links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional server-side price overrides, in integer cents. Browser-submitted
# amounts are ignored. Defaults: release review $299, bench deposit $1,250.
LAB_RELEASE_REVIEW_PRICE_CENTS=29900
LAB_BENCH_REPRODUCTION_PRICE_CENTS=125000

# Cloudflare bindings are configured through .openai/hosting.json:
# DB -> D1 metadata database; FILES -> private R2 file bucket.
